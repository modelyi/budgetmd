  <fields>
    <field code="orderCode" name="订单编号" source="MASTER_CONTRACTS"><![CDATA[存量订单行由系统带出期初合同/订单编号；增量手工新增行可用虚拟订单号实现或可不填]]></field>
    <field code="contractCode" name="销售合同" source="MASTER_CONTRACTS"><![CDATA[存量销售合同编号；增量行手工选择或可不填]]></field>
    <field code="projectName" name="销售项目" source="AA.6 预算项目主数据"><![CDATA[销售项目名称]]></field>
    <field code="budgetProduct" name="销售产品" source="AA.7 预算产品主数据"><![CDATA[对应预算产品]]></field>
    <field code="machineCode" name="机台" source="本表录入"><![CDATA[机台名称或标识，文本，用户必输]]></field>
    <field code="region" name="区域" source="区域主数据"><![CDATA[区域主数据]]></field>
    <field code="department" name="预算部门" source="AA.5 行政部门主数据字典（一级部门-二级部门）"><![CDATA[预算部门默认明细到二级部门]]></field>
    <field code="customer" name="客户名称" source="AA.4.a 客户主数据"><![CDATA[必填；客户主数据]]></field>
