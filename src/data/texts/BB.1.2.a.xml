    <field code="monthlyPrice" name="单价(不含税)" source="本表录入"><![CDATA[不含税销售单价]]></field>
    <field code="monthlyRevenue" name="预计销售收入(不含税)" source="本表公式"><![CDATA[=销量×单价(不含税)]]></field>
    <field code="monthlyPrepayment" name="预收" source="本表录入"><![CDATA[月度预收款金额]]></field>
    <field code="monthlyAcceptCollection" name="验收回款" source="本表录入"><![CDATA[月度验收回款金额]]></field>
  </fields>

  <!-- ③ 关键规则要点（原 BUSINESS_BLOCKS 按表单编码聚合） -->
  <rules>
    <rule form="BB.1.2.a 软硬件销售填报">
      <point><![CDATA[存量订单导入与增量手工新增合并为同一张表（与 BB.1.3.a 体例一致）：存量订单行由系统期初导入带出，增量行由业务人员手工新增，表样/字段完全一致。]]></point>
      <point><![CDATA[维度：订单编号/销售合同/销售项目/销售产品/机台/区域/预算部门/客户/签约主体；机台文本必输。]]></point>
      <point><![CDATA[度量：销量、单价(不含税)、预计销售收入(不含税)（=销量×单价，公式）、预收、验收回款，按月维护。]]></point>
    </rule>
  </rules>

  <!-- ④ 适用业务情形（原 APPLICABLE_SCENARIOS['BB.1.2.a']） -->
  <scenarios>
    <applies>
      <item><![CDATA[软硬件销售填报（存量订单期初导入+本年新增手工新增合并单表）：销量/单价/预收/验收回款填报]]></item>
    </applies>
    <notApplies>
      <item><![CDATA[存量+增量合并的财务核算与销售成本（属 .c）]]></item>
    </notApplies>
  </scenarios>

  <!-- ⑤ 预算编制视角：数据关系总结（原 FORM_DATA_RELATION_SUMMARY['BB.1.2.a']） -->
  <relation>
    <summary><![CDATA[软硬件销售填报（存量订单期初导入+本年新增手工新增合并单表），月度收入/预收/回款填报。]]></summary>
    <dataSources>
      <source code="MASTER_CONTRACTS" name="合同主数据" fields="订单编号、销售合同"><![CDATA[存量订单按合同编码带出；增量行可用虚拟订单号或可不填]]></source>
      <source code="AA.7" name="预算产品主数据" fields="销售产品"><![CDATA[下拉选择]]></source>
      <source code="AA.4.a" name="客户主数据" fields="客户名称"><![CDATA[必填，客户主数据选择]]></source>
      <source code="AA.5" name="行政部门字典" fields="预算部门"><![CDATA[默认明细到二级部门]]></source>
    </dataSources>
    <outputs>
      <output target="BB.1.2.c 财务视角"><![CDATA[销量/单价/预收/回款自动合并进财务视角，生成收入确认与 CF-01]]></output>
    </outputs>
    <keyRules>
      <rule><![CDATA[收入=销量×单价（公式，不可编辑）；存量与增量同表、由订单编号区分。]]></rule>
    </keyRules>
  </relation>

  <!-- ⑥ 无转换规则说明（原 NO_VOUCHER_FORM_NOTE['BB.1.2.a']） -->
  <noVoucher><![CDATA[不涉及财报转换（软硬件销售填报为业务口径，收入/预收/回款分录在财务视角 .c 生成）。]]></noVoucher>

