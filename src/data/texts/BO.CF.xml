<form code="BO.CF" name="现金流量表">

  <!-- ② 字段与值说明（原 BUDGET_FIELD_REGISTRY / 调研页字段投影，formCode='BO.CF'） -->
  <fields>
    <field code="itemName" name="项目名称" source="本表"><![CDATA[现金流量表项目名称]]></field>
    <field code="monthlyAuto" name="1~12月自动取数" source="各业务与财务编制表"><![CDATA[1~12月各月上游自动取数，来自 BA（编制前提与假设，含 BB 业务预算编制）、BF（资金与财务预算）所有影响会计报表结果的数据，按现金流映射自动归集，只读不可编辑]]></field>
    <field code="annualManualAdjust" name="全年编制手工调整" source="本表录入"><![CDATA[全年编制手工调整（年度层，不分月），财务人员在本表手工录入；若有调整需求，直接在本列手工录入]]></field>
    <field code="annualTotal" name="全年编制合计" source="本表公式"><![CDATA[=SUM(1~12月自动取数)+全年编制手工调整]]></field>
    <field code="midYearAdjust" name="年中调整数" source="本表录入"><![CDATA[年中调整数]]></field>
    <field code="executionData" name="执行数据" source="本表导入"><![CDATA[2027年手工导入执行数据，后续年度再考虑相关接口]]></field>
    <field code="budgetVariance" name="预算实际差异" source="本表公式"><![CDATA[=全年编制合计+年中调整数-执行数据]]></field>
    <field code="varianceNote" name="差异说明" source="本表录入"><![CDATA[差异原因说明]]></field>
  </fields>

  <!-- ④ 适用业务情形（原 APPLICABLE_SCENARIOS['BO.CF']） -->
  <scenarios>
    <applies>
      <item><![CDATA[按现金收付汇总经营/投资/筹资活动现金流]]></item>
    </applies>
    <notApplies>
      <item><![CDATA[损益（属 BO.PL）、资产负债（属 BO.BS）]]></item>
    </notApplies>
  </scenarios>

</form>
