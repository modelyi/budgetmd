  <!-- ③ 关键规则要点（原 BUSINESS_BLOCKS 按表单编码聚合） -->
  <rules>
    <rule form="BB.1.2.c 财务视角(存量+增量)">
      <point><![CDATA[存量与增量自动合并，全部字段系统带出只读；仅预计销售成本由财务按月手工填报。]]></point>
      <point><![CDATA[收入=销量×单价（公式）、销售成本=销量×BAA.2 标准成本；预收+验收回款驱动 CF-01。]]></point>
    </rule>
  </rules>

  <!-- ④ 适用业务情形（原 APPLICABLE_SCENARIOS['BB.1.2.c']） -->
  <scenarios>
    <applies>
      <item><![CDATA[存量+增量合并的财务视角：填预计销售成本、核对收入与回款]]></item>
    </applies>
    <notApplies>
      <item><![CDATA[销量/单价/预收/回款的原始填报（属 .a/.b）]]></item>
    </notApplies>
  </scenarios>

  <!-- ⑤ 预算编制视角：数据关系总结（原 FORM_DATA_RELATION_SUMMARY['BB.1.2.c']） -->
  <relation>
    <summary><![CDATA[存量+增量合并的财务视角，填预计销售成本并核对收入与回款。]]></summary>
    <dataSources>
      <source code="BB.1.2.a" name="销售填报" fields="销量、单价(不含税)、预收、验收回款"><![CDATA[自动合并，系统带出只读]]></source>
      <source code="BAA.2" name="产品标准成本设置" fields="标准成本"><![CDATA[销售成本=销量×BAA.2 标准成本]]></source>
    </dataSources>
    <outputs>
      <output target="BO.PL 利润表—营业收入"><![CDATA[销售收入→营业收入（按产品类别映射）]]></output>
      <output target="BO.PL 利润表—营业成本"><![CDATA[销售成本→主营业务成本 6401.1]]></output>
      <output target="BB.3.X 进销存预算"><![CDATA[销售成本→产成品转出（存货减少）]]></output>
      <output target="BO.CF 现金流量表—CF-01"><![CDATA[预收+验收回款→销售商品、提供劳务收到的现金]]></output>
    </outputs>
    <keyRules>
      <rule><![CDATA[收入=销量×单价、销售成本=销量×BAA.2；CF-01=Σ预收+Σ验收回款。]]></rule>
    </keyRules>
  </relation>

  <!-- ⑥ 财务报表项转换规则（原 FINANCIAL_STATEMENT_CONVERSION['BB.1.2.c'].items） -->
  <events>
    <event event="收入确认" field="预计销售收入(不含税)">
      <pl><![CDATA[主营业务收入 6001.1 (+)]]></pl>
      <bs><![CDATA[应收账款 (+)]]></bs>
      <cf><![CDATA[—（权责发生制）]]></cf>
      <source><![CDATA[存量(.a)+增量(.b)合并，月度销售收入=当月销量×单价（公式）]]></source>
      <entry><![CDATA[应收账款(1122) (+)；主营业务收入(6001.1) (+)]]></entry>
      <note><![CDATA[按签约主体法人归集；不含税口径，不处理增值税。]]></note>
    </event>
    <event event="销售成本结转" field="预计销售成本">
      <pl><![CDATA[主营业务成本 6401.1 (+)]]></pl>
      <bs><![CDATA[存货 (−)]]></bs>
      <cf><![CDATA[—]]></cf>
      <source><![CDATA[财务按月填报：销量×BAA.2 产品标准成本]]></source>
      <entry><![CDATA[主营业务成本(6401.1) (+)；存货—库存商品(1405) (−)]]></entry>
      <note><![CDATA[销售成本随产成品出库结转（BB.3.X 产成品转出口径）。]]></note>
    </event>
    <event event="收预收款" field="预收">
      <pl><![CDATA[—]]></pl>
      <bs><![CDATA[货币资金 (+)（合同负债 2204 直接手填，不自动取数）]]></bs>
      <cf><![CDATA[经营活动现金流入 CF-01 (+)]]></cf>
      <source><![CDATA[取自月度预收填报值]]></source>
      <entry><![CDATA[借：货币资金(1001)（合同负债 2204 直接手填）]]></entry>
      <note><![CDATA[CF-01 = Σ预收 + Σ验收回款。]]></note>
    </event>
    <event event="验收回款" field="验收回款">
      <pl><![CDATA[—]]></pl>
      <bs><![CDATA[货币资金 (+)、应收账款 (−)]]></bs>
      <cf><![CDATA[经营活动现金流入 CF-01 (+)]]></cf>
      <source><![CDATA[取自月度验收回款填报值]]></source>
      <entry><![CDATA[借：货币资金(1001)；贷：应收账款(1122)]]></entry>
      <note><![CDATA[按客户+合同+项目核算维度归集。]]></note>
    </event>
  </events>

</form>
