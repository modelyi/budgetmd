<?xml version="1.0" encoding="UTF-8"?>
<!--
  BO.PL 损益表 · 文字源（由 scripts/migrateTextsToXml.ts 自动生成，请勿手工编辑）

  口径约定：
    · 长文本一律 CDATA 包裹（<![CDATA[ 原文 ]]>），CDATA 与标签紧邻、不留空白；
    · 短标识（code / name / source / fields / target / event / field / form / cat / ref / family）用 XML 属性；
    · 结构化元数据（inputMode / required / dataType 等）不写在本文件，继续留在 TS 源；
    · 文字只搬不改：内容与 TS 文字源逐字一致（校验见 scripts/validateTextsXml.ts）。

  迁移源：ResearchSummaryView.tsx（字段说明/适用情形/数据关系/⑥转换规则）、budgetFormRegistry.ts（字段登记名）
  解析：src/utils/xmlTexts.ts（两端共用 parseFormTextXml）
    前端 —— import.meta.glob('/src/data/texts/*.xml', { as: 'raw' })
    脚本 —— scripts/generateResearchMarkdownContent.ts（readdirSync/readFileSync → registerRawTexts）
-->
<form code="BO.PL" name="损益表">

  <!-- ② 字段与值说明（原 BUDGET_FIELD_REGISTRY / 调研页字段投影，formCode='BO.PL'） -->
  <fields>
    <field code="seq" name="序号" source="本表"><![CDATA[利润表行次序号（一/二/三…为小计行）]]></field>
    <field code="itemName" name="项目名称" source="本表"><![CDATA[利润表项目名称]]></field>
    <field code="monthlyBusiness" name="上游自动取数" source="各业务与财务编制表"><![CDATA[1~12月各月上游自动取数，来自 BA（编制前提与假设，含 BB 业务预算编制）、BF（资金与财务预算）所有影响会计报表结果的数据，按科目映射自动归集，只读不可编辑]]></field>
    <field code="monthlyManualAdjust" name="编制手工调整" source="本表录入"><![CDATA[1~12月各月编制手工调整，财务人员在本表手工录入；若有调整需求，直接在本列手工录入]]></field>
    <field code="monthlySubtotal" name="编制小计" source="本表公式"><![CDATA[1~12月各月编制小计=上游自动取数+编制手工调整]]></field>
    <field code="annualTotal" name="全年编制合计" source="本表公式"><![CDATA[=SUM(1~12月编制小计)]]></field>
    <field code="midYearAdjust" name="年中调整" source="本表录入"><![CDATA[年中调整数]]></field>
    <field code="executionData" name="执行数" source="本表导入"><![CDATA[2027年手工导入实际执行数，后续年度再考虑相关接口]]></field>
    <field code="budgetVariance" name="预算实际差异" source="本表公式"><![CDATA[=年度编制合计+年中调整-执行数]]></field>
    <field code="varianceNote" name="差异说明" source="本表录入"><![CDATA[差异原因说明]]></field>
  </fields>

  <!-- ④ 适用业务情形（原 APPLICABLE_SCENARIOS['BO.PL']） -->
  <scenarios>
    <applies>
      <item><![CDATA[按会计规则汇总收入/成本/费用形成预算损益表]]></item>
    </applies>
    <notApplies>
      <item><![CDATA[资产负债（属 BO.BS）、现金流（属 BO.CF）]]></item>
    </notApplies>
  </scenarios>

</form>
