// ---------------------------------------------------------------------------
// 待与业务确认事项清单 (A1.5)
// 汇总需求梳理过程中尚未与业务方确认口径/落地方式的开放事项。
// 维护原则：只登记真实存在的开放事项（出处=需求文档「待确认」标注 或 需求讨论中悬置的问题），
// 不在此处推断或预填未确认口径；业务确认后更新「状态」并同步对应表单口径。
// ---------------------------------------------------------------------------

export interface PendingConfirmationItem {
  /** 序号 */
  seq: number;
  /** 涉及表单/模块编码 */
  formCode: string;
  /** 待确认事项简称 */
  title: string;
  /** 事项类别：口径待确认 / 落地待确认 */
  category: '口径待确认' | '落地待确认';
  /** 具体待确认内容 */
  detail: string;
  /** 影响范围与后果 */
  impact: string;
  /** 建议处理方向 */
  suggestion: string;
  /** 状态 */
  status: '待确认' | '已确认' | '待定方案';
  /** 出处 */
  source: string;
}

