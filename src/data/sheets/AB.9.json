            "isHeader": false,
            "rowSpan": 1,
            "colSpan": 1
          },
          {
            "text": "部门日常领用 → 按领用性质计入 6601 销售费用 或 6602 管理费用",
            "isHeader": false,
            "rowSpan": 1,
            "colSpan": 1
          },
          {
            "text": "启用",
            "isHeader": false,
            "rowSpan": 1,
            "colSpan": 1
          }
        ],
        [
