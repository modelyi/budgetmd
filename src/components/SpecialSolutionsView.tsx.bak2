import React, { useState } from 'react';

type TopicKey = 'cover' | 'agenda' | 'product' | 'service' | 'intercompany' | 'labor' | 'inventory' | 'vat' | 'capex';

const PAGES: { key: TopicKey; no: string; title: string }[] = [
  { key: 'cover', no: '', title: '' },
  { key: 'agenda', no: '', title: '' },
  { key: 'product', no: '01', title: '对外软硬件销售' },
  { key: 'service', no: '02', title: '对外服务销售' },
  { key: 'intercompany', no: '03', title: '集团内部关联交易' },
  { key: 'labor', no: '04', title: '雇员费用与人工成本' },
  { key: 'inventory', no: '05', title: '存货流转与成本结转' },
  { key: 'vat', no: '06', title: '增值税集中测算' },
  { key: 'capex', no: '07', title: '资本化与折旧' },
];

export const SpecialSolutionsView: React.FC = () => {
  const [idx, setIdx] = useState(0);
  const cur = PAGES[idx];
  const nav = (d: number) => setIdx((i) => Math.min(PAGES.length - 1, Math.max(0, i + d)));
  return (
    <main className="flex-1 min-h-0 flex flex-col bg-[#F7F7F8]">
      <div className="flex-1 min-h-0 overflow-auto">
        {cur.key === 'cover' && <CoverPage />}
        {cur.key === 'agenda' && <AgendaPage />}
        {cur.key === 'product' && <ProductPage />}
        {cur.key === 'service' && <ServicePage />}
        {cur.key === 'intercompany' && <IntercompanyPage />}
        {cur.key === 'labor' && <LaborPage />}
        {cur.key === 'inventory' && <InventoryPage />}
        {cur.key === 'vat' && <VatPage />}
        {cur.key === 'capex' && <CapexPage />}
      </div>
      <div className="shrink-0 border-t border-slate-200 bg-white px-6 py-2.5 flex items-center justify-between">
        <button onClick={() => nav(-1)} disabled={idx === 0}
          className="px-3 py-1.5 text-xs rounded border border-slate-300 disabled:opacity-30 hover:bg-slate-50 cursor-pointer">‹ 上一页</button>
        <div className="text-xs text-slate-500">
          {cur.no && <span className="text-[#C9A66B] font-semibold mr-2">{cur.no}</span>}
          {cur.title && <span className="font-medium text-slate-700">{cur.title}</span>}
          <span className="ml-3 text-slate-400">{idx + 1} / {PAGES.length}</span>
        </div>
        <button onClick={() => nav(1)} disabled={idx === PAGES.length - 1}
          className="px-3 py-1.5 text-xs rounded border border-slate-300 disabled:opacity-30 hover:bg-slate-50 cursor-pointer">下一页 ›</button>
      </div>
    </main>
  );
};

const Page: React.FC<{ children: React.ReactNode }> = ({ children }) => (
  <div style={{ maxWidth: 960, margin: '0 auto', padding: '32px 40px' }}>{children}</div>
);
const Eyebrow: React.FC<{ children: React.ReactNode }> = ({ children }) => (
  <div style={{ fontSize: 12, color: '#C9A66B', letterSpacing: 2, fontWeight: 600 }}>{children}</div>
);
const Title: React.FC<{ children: React.ReactNode }> = ({ children }) => (
  <div style={{ fontSize: 24, fontWeight: 700, color: '#0D1B2A', marginTop: 6 }}>{children}</div>
);
const Divider: React.FC = () => <div style={{ height: 1, background: '#E2E2E2', margin: '16px 0' }} />;
const Layer: React.FC<{ children: React.ReactNode }> = ({ children }) => (
  <div style={{ fontSize: 11, color: '#6B7280', letterSpacing: 1, fontWeight: 600, marginBottom: 8 }}>{children}</div>
);
const Card: React.FC<{ children: React.ReactNode; highlight?: boolean }> = ({ children, highlight }) => (
  <div style={{ flex: 1, minWidth: 200, padding: 12, borderRadius: 8,
    background: highlight ? 'rgba(201,166,107,0.12)' : '#fff',
    border: '0.5px solid #E2E2E2', fontSize: 12, lineHeight: 1.6, color: '#1A1B1C' }}>{children}</div>
);
const Row: React.FC<{ children: React.ReactNode }> = ({ children }) => (
  <div style={{ display: 'flex', gap: 10, flexWrap: 'wrap', marginBottom: 14 }}>{children}</div>
);
const Entry: React.FC<{ children: React.ReactNode }> = ({ children }) => (
  <div style={{ flex: 1, minWidth: 260, padding: '10px 12px', background: '#fff', border: '0.5px solid #E2E2E2', borderRadius: 8, fontSize: 12, lineHeight: 1.7 }}>{children}</div>
);
const Warn: React.FC<{ children: React.ReactNode }> = ({ children }) => (
  <div style={{ padding: 12, background: 'rgba(201,166,107,0.15)', borderRadius: 8, fontSize: 12, lineHeight: 1.7 }}>{children}</div>
);

const CoverPage: React.FC = () => (
  <div style={{ minHeight: '100%', background: '#0D1B2A', display: 'flex', flexDirection: 'column', justifyContent: 'center', padding: '0 80px' }}>
    <div style={{ width: 6, height: 40, background: '#C9A66B', marginBottom: 24 }} />
    <div style={{ fontSize: 13, color: '#C9A66B', letterSpacing: 3, fontWeight: 600 }}>SPECIAL SOLUTIONS · FOR CFO</div>
    <div style={{ fontSize: 40, fontWeight: 700, color: '#fff', marginTop: 12 }}>全面预算管理系统</div>
    <div style={{ fontSize: 26, color: '#fff', marginTop: 8 }}>专项方案说明</div>
    <div style={{ width: 120, height: 2, background: '#C9A66B', margin: '24px 0' }} />
    <div style={{ fontSize: 14, color: '#A0AAB9' }}>面向 CFO / 预算主管 · 七大业务方案速览</div>
  </div>
);

const AgendaPage: React.FC = () => (
  <Page>
    <Eyebrow>目录 · CONTENTS</Eyebrow>
    <Title>七大业务方案速览</Title>
    <Divider />
    <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '20px 40px' }}>
      {([
        ['01', '对外软硬件销售', 'BB.1.2 · 卖产品的收入成本账'],
        ['02', '对外服务销售', 'BB.1.3 · 卖服务的收入成本账'],
        ['03', '集团内部关联交易', 'BJ.C · 单体计损益、合并全额抵销'],
        ['04', '雇员费用与人工成本', 'BB.5.1 · 不重复计提、按部门冲减'],
        ['05', '存货流转与成本结转', 'BB.3.X · 料工费→产成品→销售'],
        ['06', '增值税集中测算', 'BF.4.b · 业务不含税、税金表统一算'],
        ['07', '资本化与折旧', 'BB.4.X · 资本支出形成资产、折旧进成本'],
      ] as [string, string, string][]).map(([n, t, d]) => (
        <div key={n} style={{ display: 'flex', gap: 12, padding: '10px 0', borderBottom: '0.5px solid #E2E2E2' }}>
          <div style={{ fontSize: 20, fontWeight: 700, color: '#C9A66B' }}>{n}</div>
          <div>
            <div style={{ fontSize: 15, fontWeight: 600, color: '#0D1B2A' }}>{t}</div>
            <div style={{ fontSize: 11, color: '#6B7280', marginTop: 2 }}>{d}</div>
          </div>
        </div>
      ))}
    </div>
  </Page>
);

const ProductPage: React.FC = () => (
  <Page>
    <Eyebrow>01 · BB.1.2</Eyebrow>
    <Title>对外软硬件销售：卖产品的收入成本账</Title>
    <Divider />
    <Layer>① 填报层</Layer>
    <Row><Card highlight><b>BB.1.2.a 软硬件销售填报 〔销售岗〕</b><br />存量订单导入 + 增量手工同表；销量×单价=收入；预收/验收回款</Card></Row>
    <Layer>② 财务视角（合并只读）</Layer>
    <Row><Card highlight><b>BB.1.2.c</b><br />收入带出；预计销售成本财务按月填（销量×BAA.2 标准成本）</Card></Row>
    <Layer>③ 分录 → 三表落点</Layer>
    <Row>
      <Entry><b>收入确认</b><br />借 1122 ／ 贷 6001.1（硬件/软件）<br />→ PL 6001.1 · BS 1122</Entry>
      <Entry><b>成本结转</b><br />借 6401.1 ／ 贷 1405 存货<br />→ PL 6401.1 · BS 1405</Entry>
      <Entry><b>回款</b><br />借 1001 ／ 贷 2204 / 1122<br />→ CF-01（货物×1.13）</Entry>
    </Row>
    <Warn><b>跨法人调货</b>（产品从兄弟法人调入）：提供方借 1221.1／贷 6001.2（成本+加成）、借 6401.2／贷 1405；签约主体借 6401.1（加成进成本）／贷 2241.1。合并层 6001.2↔6401.1 对冲，6401.2 保留。</Warn>
  </Page>
);

const ServicePage: React.FC = () => (
  <Page>
    <Eyebrow>02 · BB.1.3</Eyebrow>
    <Title>对外服务销售：现场服务才拆人工+物料</Title>
    <Divider />
    <Layer>① 填报层（业务岗）</Layer>
    <Row>
      <Card><b>.a 服务销售〔销售岗〕</b><br />存量+增量同表；销量×单价=收入</Card>
      <Card><b>.d 物料明细〔交易路径岗〕</b><br />好件/坏件分行；内部供应商列</Card>
      <Card><b>.g 人工明细〔交易路径岗〕</b><br />岗位×月度工时；内部供应商列</Card>
    </Row>
    <Layer>② 分录 → 三表落点</Layer>
    <Row>
      <Entry><b>收入</b><br />借 1122 ／ 贷 6001.1<br />→ PL 6001.1</Entry>
      <Entry><b>物料成本</b><br />借 6401.1 ／ 贷 1405</Entry>
      <Entry><b>人工成本</b><br />借 6401.1 ／ 贷 6601/6602/6603/5001（按部门冲减，不重复计提）</Entry>
      <Entry><b>回款</b><br />→ CF-01（服务×1.06）</Entry>
    </Row>
    <Warn><b>跨法人内部供货</b>：提供方借 1221.1／贷 6001.2（成本+加成）、借 6401.2／贷 1405/费用；签约主体借 6401.1（加成进成本）／贷 2241.1。增值税物料13%/人工6%。合并层 6001.2↔6401.1 对冲，6401.2 保留。</Warn>
  </Page>
);

const IntercompanyPage: React.FC = () => (
  <Page>
    <Eyebrow>03 · BJ.C</Eyebrow>
    <Title>集团内部关联交易：单体计损益、合并全额抵销</Title>
    <Divider />
    <Layer>① 五类关联交易</Layer>
    <Row>
      <Card><b>代采购物料</b><br />BB.3.3.D 驱动；平价转移+加成(BAA.11)</Card>
      <Card><b>代采购资产</b><br />原值平移 B 侧；按 B 侧剩余年限折旧</Card>
      <Card><b>资产转卖</b><br />净值平移+加成进 6115；买方续提折旧</Card>
      <Card><b>内部借款</b><br />本金 1221.1/2241.1；利息 6001.2↔6604.1</Card>
      <Card><b>内部职场租赁</b><br />&gt;1年资本化(1621/2602)；≤1年费用化</Card>
    </Row>
    <Warn><b>合并抵销（CAS 33）</b>：提供方收入 ↔ 接受方成本/费用全额对冲；1221.1↔2241.1 往来对冲；内部现金流对冲。<b>合并对三表 0 影响</b>。税率：货物13%、服务6%、租赁9%，合并层销项进项自然对冲。例外：内部借款利息进项不得抵扣。</Warn>
  </Page>
);

const LaborPage: React.FC = () => (
  <Page>
    <Eyebrow>04 · BB.5.1</Eyebrow>
    <Title>雇员费用：一笔工资只出一次</Title>
    <Divider />
    <Layer>① HR 统一计提（四列）</Layer>
    <Row>
      <Card>销售费用 → 6601</Card>
      <Card>管理费用 → 6602</Card>
      <Card>研发费用 → 6603</Card>
      <Card>制造费用 → 5001</Card>
    </Row>
    <Layer>② 项目型人工按部门属性冲减（AM.2→AB.14）</Layer>
    <Row>
      <Card highlight><b>技术服务人工 BB.1.3.i</b><br />借 6401.1 ／ 贷 6601/6602/6603/5001</Card>
      <Card highlight><b>自制设备人工 BB.4.1.b</b><br />借 1604 在建工程 ／ 贷 费用科目（资本化）</Card>
    </Row>
    <Warn><b>三条铁律</b><br />① 不重复计提 2211：只是费用重分类。<br />② 付现只走一次：发薪在 BB.5.1 CF-06。<br />③ 跨法人人工同物料模型：提供方 6001.2/6401.2、接受方 6401.1 含加成。</Warn>
  </Page>
);

const InventoryPage: React.FC = () => (
  <Page>
    <Eyebrow>05 · BB.3.X</Eyebrow>
    <Title>存货流转：料工费 → 产成品 → 销售领用</Title>
    <Divider />
    <Row>
      <Card><b>原材料入库</b><br />BB.3.3.C 到货额+代采购平价转入</Card>
      <Card>→</Card>
      <Card><b>在制品</b><br />料←领料；工←制造人工；费←BB.5.2+折旧</Card>
      <Card>→</Card>
      <Card><b>产成品</b><br />= 产量×BAA.2 标准成本</Card>
      <Card>→</Card>
      <Card highlight><b>出库</b><br />BB.1.2 销售 / BB.1.3 服务物料</Card>
    </Row>
    <Warn><b>关键口径</b>：出入库按法人逐来源取数、不按比例拆分；代采购平价转移<b>不含加成</b>（加成走 6001.2↔6602/6401.1，不进存货）；各法人加总=集团存货列报。整机销售只认综合产品成本不拆料工。</Warn>
  </Page>
);

const VatPage: React.FC = () => (
  <Page>
    <Eyebrow>06 · BF.4.b</Eyebrow>
    <Title>增值税集中测算：业务不含税、税金表统一算</Title>
    <Divider />
    <Row>
      <Card><b>BF.4.a 税金主表</b><br />增值税行不手填，从 .b 带出；附加税按实缴联动</Card>
      <Card highlight><b>BF.4.b 增值税附表</b><br />销项−进项±留抵=净应纳；货物13%/服务6%/租赁9%</Card>
    </Row>
    <Warn><b>内部交易增值税</b>：提供方计销项、接受方计进项（同额同率），价外税不影响损益。<b>合并层销项进项自然对冲（净0）</b>。例外：内部借款利息进项不得抵扣。</Warn>
  </Page>
);

const CapexPage: React.FC = () => (
  <Page>
    <Eyebrow>07 · BB.4.X</Eyebrow>
    <Title>资本化与折旧：与 OPEX 切清</Title>
    <Divider />
    <Layer>① 哪些支出资本化</Layer>
    <Row>
      <Card><b>外购固定资产</b><br />借 1601 / 1604（需安装）</Card>
      <Card><b>自制设备</b><br />料工费归集 1604；人工从 BB.5.1 冲减</Card>
      <Card><b>&gt;1年职场租赁</b><br />1621/2602；≤1年费用化</Card>
      <Card><b>代采购资产</b><br />原值平移 B 侧；按 B 侧剩余年限折旧</Card>
    </Row>
    <Layer>② 资产路径</Layer>
    <Row>
      <Card highlight><b>转固</b><br />借 1601 ／ 贷 1604；次月起折旧</Card>
      <Card highlight><b>月度折旧</b><br />借 5101/6601/6602/6603 ／ 贷 1602</Card>
    </Row>
    <Warn><b>资本化条件</b>：使用周期 &gt;1 年、达 AA.9 门槛、形成长期资源。日常维修、低值易耗品、≤1年租赁直接 BB.5.2 费用化。资产类别全库唯一字段（取 AA.9 层级），不拆大类小类。</Warn>
  </Page>
);
