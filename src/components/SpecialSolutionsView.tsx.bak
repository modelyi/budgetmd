import React, { useState } from 'react';

/**
 * 专项方案说明页：跨表单的业务专题方案汇总。
 * 卡片式分层表达，让财务人员一眼看懂业务方案；细节在对应表单页展开。
 */

interface Topic { key: string; no: string; title: string; oneLiner: string; }

const TOPICS: Topic[] = [
  { key: 'product', no: '一', title: '对外软硬件销售预算方案', oneLiner: 'BB.1.2 · 卖产品的收入成本账（整机/软件）' },
  { key: 'service', no: '二', title: '对外服务销售预算方案', oneLiner: 'BB.1.3 · 卖服务的收入成本账' },
  { key: 'intercompany', no: '三', title: '集团内部关联交易', oneLiner: 'BJ.C · 单体计损益、合并全额抵销' },
  { key: 'labor', no: '四', title: '雇员费用与人工成本', oneLiner: 'BB.5.1 · 不重复计提、按部门属性冲减' },
  { key: 'inventory', no: '五', title: '存货流转与成本结转', oneLiner: 'BB.3.X · 料工费→产成品→销售领用' },
  { key: 'vat', no: '六', title: '增值税集中测算', oneLiner: 'BF.4.b · 业务表不含税、税金表统一算' },
  { key: 'capex', no: '七', title: '资本化与折旧方案', oneLiner: 'BB.4.X · 资本性支出形成长期资产、折旧进成本' },
];

export const SpecialSolutionsView: React.FC = () => {
  const [active, setActive] = useState<string>('service');
  return (
    <main className="flex-1 min-h-0 min-w-0 flex overflow-hidden">
      <aside className="w-56 shrink-0 border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-y-auto custom-scrollbar">
        <div className="px-3 py-3 border-b border-slate-100 dark:border-slate-800">
          <div className="text-xs font-bold text-slate-900 dark:text-slate-100">专项方案</div>
          <div className="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">面向 CFO / 预算主管 · 业务方案速览</div>
        </div>
        <nav className="p-2 space-y-0.5">
          {TOPICS.map((t) => (
            <button key={t.key} onClick={() => setActive(t.key)}
              className={`w-full text-left px-2.5 py-2 rounded-md text-xs transition-colors cursor-pointer ${active === t.key ? 'bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800'}`}>
              <div>{t.no}、{t.title}</div>
              <div className="text-[10px] text-slate-400 mt-0.5 font-normal">{t.oneLiner}</div>
            </button>
          ))}
        </nav>
      </aside>
      <div className="flex-1 min-w-0 overflow-y-auto custom-scrollbar">
        {active === 'product' && <ProductTopic />}
        {active === 'service' && <ServiceTopic />}
        {active === 'intercompany' && <IntercompanyTopic />}
        {active === 'labor' && <LaborTopic />}
        {active === 'inventory' && <InventoryTopic />}
        {active === 'vat' && <VatTopic />}
        {active === 'capex' && <CapitalTopic />}
      </div>
    </main>
  );
};

/* ── 通用卡片组件 ── */
const LayerLabel: React.FC<{ children: React.ReactNode }> = ({ children }) => (
  <div style={{ marginTop: 14, fontSize: 12, fontWeight: 600, color: '#6B7280', letterSpacing: 1 }}>{children}</div>
);

const Card: React.FC<{ title: React.ReactNode; desc?: string; accent?: 'teal' | 'blue' | 'white'; children?: React.ReactNode }> = ({ title, desc, accent = 'white', children }) => {
  const bg = accent === 'teal' ? 'linear-gradient(135deg,rgba(148,212,208,0.18),rgba(148,212,208,0.32))'
    : accent === 'blue' ? 'linear-gradient(135deg,rgba(155,187,244,0.18),rgba(155,187,244,0.32))' : '#fff';
  const border = accent === 'white' ? '0.5px solid rgba(0,0,0,0.08)' : 'none';
  return (
    <div style={{ flex: '1 1 220px', padding: 12, background: bg, border: border, borderRadius: 12, boxSizing: 'border-box' }}>
      <div style={{ fontSize: 13.5, fontWeight: 600, color: '#1A1B1C' }}>{title}</div>
      {desc && <div style={{ fontSize: 12, color: '#6B7280', marginTop: 4, lineHeight: 1.6 }}>{desc}</div>}
      {children && <div style={{ fontSize: 12, color: '#1A1B1C', marginTop: 6, lineHeight: 1.7 }}>{children}</div>}
    </div>
  );
};

const EntryCard: React.FC<{ title: string; children: React.ReactNode }> = ({ title, children }) => (
  <div style={{ flex: '1 1 260px', padding: '10px 12px', background: '#fff', border: '0.5px solid rgba(0,0,0,0.08)', borderRadius: 10, fontSize: 12, lineHeight: 1.7, color: '#1A1B1C' }}>
    <b>{title}</b><br />{children}
  </div>
);

const WarnBox: React.FC<{ title: string; children: React.ReactNode }> = ({ title, children }) => (
  <div style={{ marginTop: 14, padding: 12, background: 'rgba(228,212,143,0.18)', borderRadius: 12, boxSizing: 'border-box' }}>
    <div style={{ fontSize: 13, fontWeight: 600, color: '#1A1B1C' }}>{title}</div>
    <div style={{ fontSize: 12, color: '#1A1B1C', marginTop: 6, lineHeight: 1.7 }}>{children}</div>
  </div>
);

const TopicHeader: React.FC<{ title: string; tagline: string }> = ({ title, tagline }) => (
  <div style={{ padding: '20px 20px 0' }}>
    <div style={{ fontSize: 16, fontWeight: 600, color: '#1A1B1C' }}>{title}</div>
    <div style={{ fontSize: 12, color: '#6B7280', marginTop: 4 }}>{tagline}</div>
  </div>
);

const FlowRow: React.FC<{ children: React.ReactNode }> = ({ children }) => (
  <div style={{ display: 'flex', gap: 10, flexWrap: 'wrap', marginTop: 6 }}>{children}</div>
);

/* ============ 一、对外软硬件销售 ============ */
const ProductTopic: React.FC = () => (
  <div style={{ paddingBottom: 24 }}>
    <TopicHeader title="BB.1.2 软硬件收入与成本预算" tagline="定位：「卖产品」的收入成本账（整机硬件/软件销售）；成本只认综合产品成本，不拆料工" />
    <div style={{ padding: '0 20px' }}>
      <LayerLabel>① 填报层（业务岗录入）</LayerLabel>
      <FlowRow>
        <Card title="BB.1.2.a 软硬件销售填报 〔销售岗〕" desc="存量订单期初导入 + 增量手工新增（同表，订单编号区分）" accent="teal">
          销量 × 单价(不含税) = <b>确认收入</b><br />月度：预收 / 验收回款
        </Card>
      </FlowRow>
      <div style={{ textAlign: 'center', color: '#94D4D0', fontSize: 18, lineHeight: 1, margin: '6px 0' }}>↓ 系统汇总（只读）</div>
      <LayerLabel>② 财务视角（合并存量+增量，出分录）</LayerLabel>
      <FlowRow>
        <Card title="BB.1.2.c 财务视角主表" accent="blue">
          收入（带出）＋ <b>预计销售成本</b>（财务按月填，=销量×BAA.2标准成本）<br />自动合并存量+增量
        </Card>
      </FlowRow>
      <LayerLabel>③ 单体分录 → 三表落点（按签约主体法人归集）</LayerLabel>
      <FlowRow>
        <EntryCard title="收入确认">借 1122 应收 ／ 贷 6001.1 主营业务收入（硬件600101/软件600103）<br />→ PL <b>6001.1</b> ／ BS <b>1122</b></EntryCard>
        <EntryCard title="销售成本结转">借 6401.1 主营业务成本 ／ 贷 1405 存货<br />→ PL <b>6401.1</b> ／ BS <b>1405</b></EntryCard>
        <EntryCard title="回款">预收 / 验收回款<br />借 1001 ／ 贷 2204 / 1122<br />→ CF <b>CF-01</b>（货物回款×1.13）</EntryCard>
      </FlowRow>
      <WarnBox title="跨法人调货（产品从兄弟法人调入）">
        <b>提供方</b>：借 1221.1 ／ 贷 6001.2（出库成本+加成）；借 6401.2 ／ 贷 1405（出库成本）。<br />
        <b>签约主体</b>：借 6401.1 主营业务成本（出库成本+加成，<b>加成进成本</b>）／ 贷 2241.1。<br />
        往来真实现金结算；增值税 13% 在 BF.4.b。<b>合并层</b>：6001.2↔6401.1 全额对冲，6401.2 保留为集团真实成本。
      </WarnBox>
    </div>
  </div>
);
/* ============ 一、技术服务交易 ============ */
