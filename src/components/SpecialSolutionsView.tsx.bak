        </Card>
      </FlowRow>
      <div style={{ textAlign: 'center', color: '#94D4D0', fontSize: 18, lineHeight: 1, margin: '6px 0' }}>↓ 系统汇总（只读）</div>
      <LayerLabel>② 财务视角（合并存量+增量，出分录）</LayerLabel>
      <FlowRow>
        <Card title="BB.1.3.c 财务视角主表" accent="blue">
          收入（带出）＋ <b>人工成本</b>（.i 汇总）＋ <b>物料成本</b>（.f 汇总）＋ 其他费用（手工）
        </Card>
        <Card title="BB.1.3.f / .i" desc="物料 / 人工财务查询" />
      </FlowRow>
      <LayerLabel>③ 单体分录 → 三表落点（按签约主体法人归集）</LayerLabel>
      <FlowRow>
        <EntryCard title="收入确认">借 1122 应收 ／ 贷 6001.1 主营业务收入<br />→ PL <b>6001.1</b> ／ BS <b>1122</b></EntryCard>
        <EntryCard title="物料成本">好件×好件成本 − 坏件×坏件成本<br />借 6401.1 ／ 贷 1405 存货<br />→ PL <b>6401.1</b> ／ BS <b>1405</b></EntryCard>
        <EntryCard title="人工成本">工时×BAA.3 费率<br />借 6401.1 ／ 贷 6601/6602/6603/5001（按部门属性冲减，<b>不重复计提 2211</b>）<br />→ PL <b>6401.1</b></EntryCard>
        <EntryCard title="回款">预收 / 验收回款<br />借 1001 ／ 贷 2204 / 1122<br />→ CF <b>CF-01</b>（服务回款×1.06）</EntryCard>
      </FlowRow>
      <WarnBox title="跨法人内部供货（明细行「内部供应商」列登记）">
        <b>内部调货统一真实购销模型</b>（BB.1.2 软硬件 / BB.1.3 服务物料·人工同构）：提供方记 6001.2 完整销售价（成本+加成）、按成本结转 6401.2；接受方（签约主体）按采购价（出库成本+加成）计入 <b>6401.1 主营业务成本（加成进成本，不走期间费用）</b>。<br />
        往来 1221.1/2241.1 真实现金结算；增值税物料 13%/人工 6% 在 BF.4.b。集团合并层 6001.2↔6401.1 专门对冲、6401.2 保留为集团真实成本。
      </WarnBox>
    </div>
  </div>
);

/* ============ 二、集团内部关联交易 ============ */
const IntercompanyTopic: React.FC = () => (
  <div style={{ paddingBottom: 24 }}>
    <TopicHeader title="BJ.C 关联交易与内部抵销" tagline="定位：集团内法人间的买卖/拆借/租赁，单体各自计损益，合并层全额抵销不留痕" />
    <div style={{ padding: '0 20px' }}>
      <LayerLabel>① 五类关联交易</LayerLabel>
      <FlowRow>
        <Card title="代采购物料" desc="BB.3.3.D 驱动 → BJ.C.a 只读镜像" accent="teal">
          两岗接力：采购岗填下单主体、关联交易岗补受益主体；到货额平价转移 + 加成款(BAA.11)
        </Card>
        <Card title="代采购资产" desc="BB.3.1.D 驱动 → BJ.C.e 只读镜像">
          同上；资产原值平移到 B 侧，折旧由 BB.4.5 按 B 侧剩余年限计提
        </Card>
        <Card title="资产转卖" desc="BJ.C.d 逐笔登记">
          账面净值平移 + 加成进 6115；买方按转卖价续提折旧
        </Card>
        <Card title="内部借款" desc="BJ.C.f 逐笔登记">
          本金挂 1221.1/2241.1；利息提供方 6001.2 ↔ 借入方 6604.1
        </Card>
        <Card title="内部职场租赁" desc="BB.4.2.b / .b.1">
          一年以上资本化(1621/2602)，一年以下费用化；租金+加成款
        </Card>
      </FlowRow>
      <LayerLabel>② 单体分录模板</LayerLabel>
      <FlowRow>
        <EntryCard title="提供方">借 1221.1 其他应收-内部往来 ／ 贷 6001.2 其他业务收入-内部往来（加成部分）</EntryCard>
        <EntryCard title="接受方">借 存货/费用/资产 ／ 贷 2241.1 其他应付-内部往来</EntryCard>
      </FlowRow>
      <WarnBox title="集团合并抵销（CAS 33）">
        提供方收入 ↔ 接受方成本/费用全额对冲；1221.1 ↔ 2241.1 往来对冲；内部结算现金流对冲。<b>合并口径对三表 0 影响</b>。含税结算：货物 13%、服务 6%、租赁 9%（AB.15），合并层销项进项自然对冲。
      </WarnBox>
    </div>
  </div>
);

