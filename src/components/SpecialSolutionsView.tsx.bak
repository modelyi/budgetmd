        <Card title="产成品" desc="在制品结转 = 产量×BAA.2 标准成本" />
        <Card title="出库消耗" desc="BB.1.2 销售成本 / BB.1.3 服务物料" />
      </FlowRow>
      <WarnBox title="关键口径">
        所有出入库<b>按法人逐来源取数、不按比例拆分</b>；代采购平价转移合并层对冲、<b>不含加成</b>（加成走 6001.2↔6602/6401.1，不进存货）。各法人加总 = 集团存货列报。
      </WarnBox>
    </div>
  </div>
);

/* ============ 五、增值税 ============ */
const VatTopic: React.FC = () => (
  <div style={{ paddingBottom: 24 }}>
    <TopicHeader title="BF.4.b 增值税集中测算" tagline="定位：业务表一律不含税，销项−进项在税金表统一算，不散落各业务表" />
    <div style={{ padding: '0 20px' }}>
      <LayerLabel>① 结构</LayerLabel>
      <FlowRow>
        <Card title="BF.4.a 税金主表" desc="增值税行不手填，从 BF.4.b 带出；附加税按实缴基数联动" accent="teal" />
        <Card title="BF.4.b 增值税附表" desc="销项 − 进项 ± 留抵 = 净应纳；基数×税率（货物13%/服务6%/租赁9%，AB.15）" />
      </FlowRow>
      <WarnBox title="内部交易增值税">
        提供方计销项、接受方计进项（同额同率），价外税不影响损益；含税现金 = 结算额×(1+税率)。<b>集团合并层销项与进项自然对冲（净0）</b>。例外：内部借款利息进项不得抵扣。
      </WarnBox>
    </div>
  </div>
);

/* ============ 六、资本化与折旧 ============ */
const CapitalTopic: React.FC = () => (
  <div style={{ paddingBottom: 24 }}>
    <TopicHeader title="BB.4.X 资本化与折旧方案" tagline="定位：资本性支出形成长期资产（固定资产/使用权资产），折旧按使用部门进成本；与费用化(OPEX)切清" />
    <div style={{ padding: '0 20px' }}>
      <LayerLabel>① 哪些支出资本化</LayerLabel>
      <FlowRow>
        <Card title="外购固定资产" desc="BB.4.1 外购" accent="teal">
          借 1601 固定资产 / 1604 在建工程（需安装）
        </Card>
        <Card title="自制设备" desc="BB.4.1.b 自制">
          料工费归集进 1604 在建工程；人工从 BB.5.1 费用科目冲减
        </Card>
        <Card title="一年以上职场租赁" desc="BB.4.2.b / .b.1">
          使用权资产 1621 / 租赁负债 2602；一年以下直接费用化
        </Card>
        <Card title="代采购资产" desc="BB.3.1.D → BJ.C.e">
          原值平移到受益方法人；折旧按 B 侧剩余年限计提
        </Card>
      </FlowRow>
      <LayerLabel>② 资产路径与折旧</LayerLabel>
      <FlowRow>
        <EntryCard title="在建工程→转固">借 1601 固定资产 ／ 贷 1604 在建工程（完工转固次月起折旧）</EntryCard>
        <EntryCard title="月度折旧">借 5101/6601/6602/6603（按使用部门）／ 贷 1602 累计折旧<br />→ PL 对应费用/成本行</EntryCard>
      </FlowRow>
      <WarnBox title="与费用化(OPEX)切分原则">
        <b>资本化条件</b>：使用周期 &gt; 1 年、单位价值达 AA.9 资产类别门槛、形成可长期使用的经济资源。<br />
        日常维修、低值易耗品、短期租赁（≤1年）直接走 BB.5.2 费用化，不进 1601。<br />
        <b>资产类别</b>全库唯一字段（取 AA.9 层级，如"固定资产-生产机器设备"），不拆大类小类。
      </WarnBox>
    </div>
  </div>
);