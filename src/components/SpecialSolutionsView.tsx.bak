        <b>③ 跨法人人工</b>：与物料同构（提供方 6001.2/6401.2、接受方 6401.1 含加成），见专题一。
      </WarnBox>
    </div>
  </div>
);

/* ============ 四、存货流转 ============ */
const InventoryTopic: React.FC = () => (
  <div style={{ paddingBottom: 24 }}>
    <TopicHeader title="BB.3.X 存货周转" tagline="定位：按法人×存货类别滚动结转，料工费→产成品→销售/服务领用" />
    <div style={{ padding: '0 20px' }}>
      <LayerLabel>① 流转路径</LayerLabel>
      <FlowRow>
        <Card title="原材料入库" desc="BB.3.3.C 到货额 + 代采购平价转入" accent="teal" />
